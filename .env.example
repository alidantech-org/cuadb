# Native development: bind only to the local loopback interface.
# Docker overrides CUADB_HOST=0.0.0.0 inside its runtime container.
CUADB_HOST=127.0.0.1
CUADB_PORT=4848

# Set only in your local process environment, NOT in a committed file.
# For Docker-to-Docker, postgis is a container name on a shared network.
# CUADB_DATABASE_URL=postgresql://cuadb_viewer:CHANGE_ME@postgis:5432/mydb?sslmode=disable
# Local trust-auth ONLY (never expose a superuser on a shared network):
# CUADB_DATABASE_URL=postgresql://postgres@localhost:5432/postgres
# The passwordless exception is limited to loopback and defaults to no TLS.
# Use sslmode=verify-full with a trusted CA outside private local networks.

CUADB_CONNECTION_TIMEOUT_MS=5000
CUADB_QUERY_TIMEOUT_MS=15000
CUADB_REQUEST_TIMEOUT_MS=30000
CUADB_DEFAULT_PAGE_SIZE=25
CUADB_MAX_PAGE_SIZE=100
CUADB_MAX_POOL_CONNECTIONS=4
CUADB_MAX_IN_FLIGHT_REQUESTS=64
CUADB_MAX_REQUEST_BODY_BYTES=65536

# MySQL/MariaDB use the same trusted server-only variable. Remote TLS verification
# is on by default; optionally specify ?ssl-mode=verify_identity.
# CUADB_DATABASE_URL=mysql://cuadb_viewer:CHANGE_ME@db.example:3306/appdb
# CUADB_DATABASE_URL=mariadb://cuadb_viewer:CHANGE_ME@db.example:3306/appdb
# SQLite databases must be regular files inside this explicitly allowed root.
CUADB_SQLITE_ROOT=/data # Use an existing local directory outside Docker
# CUADB_DATABASE_URL=sqlite:////data/example.db
