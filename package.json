{
  "name": "cuadb",
  "version": "0.1.0",
  "private": true,
  "description": "Bun task runner for the Rust and HTMX CuaDB shell",
  "scripts": {
    "setup": "bun scripts/tasks.ts setup",
    "dev": "bun scripts/tasks.ts dev",
    "check": "bun scripts/tasks.ts check",
    "build": "bun scripts/tasks.ts build",
    "start": "bun scripts/tasks.ts start",
    "format": "bun scripts/tasks.ts format",
    "format:check": "bun scripts/tasks.ts format:check",
    "test": "bun scripts/tasks.ts test",
    "assets:build": "bun scripts/tasks.ts assets",
    "docker:build": "docker build -t cuadb:local .",
    "docker:run": "docker run --rm --name cuadb -p 127.0.0.1:4848:4848 cuadb:local",
    "task:preview": "bun scripts/roadmap/seed.ts --preview",
    "task:seed": "bun scripts/roadmap/seed.ts --seed",
    "task:verify": "bun scripts/roadmap/seed.ts --verify",
    "task:repair": "bun scripts/roadmap/seed.ts --repair",
    "smoke": "bun scripts/tasks.ts smoke",
    "deps:sync": "bun scripts/tasks.ts deps:sync"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.4",
    "@types/bun": "1.4.2",
    "htmx.org": "2.0.11",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3"
  }
}
